# OpenQase public (anon) credentials — read-only fetch of published content.
# Use production openqase.com project keys, or local Supabase anon keys for a local DB.
#
# Do NOT put a service-role key here. This repo only needs SELECT on published rows.

OPENQASE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
OPENQASE_SUPABASE_ANON_KEY=your_anon_key_here
